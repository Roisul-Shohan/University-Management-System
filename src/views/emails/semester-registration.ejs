<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Semester Registration Complete</title>
  </head>
  <body
    style="
      margin: 0;
      padding: 32px;
      background: #f4f7fb;
      font-family: Arial, sans-serif;
      color: #1f2937;
    "
  >
    <main
      style="
        max-width: 600px;
        margin: auto;
        padding: 36px;
        background: #fff;
        border-radius: 12px;
      "
    >
      <h1>Semester Registration Complete</h1>
      <p>Hello <strong><%= name %></strong>,</p>
      <p><%= message %></p>
      <p style="color: #6b7280; font-size: 12px">
        © <%= year %> University Management System
      </p>
    </main>
  </body>
</html>
