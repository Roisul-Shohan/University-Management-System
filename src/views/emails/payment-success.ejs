<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta
    name="viewport"
    content="width=device-width, initial-scale=1.0"
  />
  <title>Payment Successful</title>
</head>
<body
  style="
    margin: 0;
    padding: 0;
    background-color: #f4f7fb;
    font-family: Arial, Helvetica, sans-serif;
    color: #1f2937;
  "
>
  <table
    width="100%"
    cellpadding="0"
    cellspacing="0"
    border="0"
    style="background-color: #f4f7fb; padding: 40px 15px;"
  >
    <tr>
      <td align="center">
        <!-- Main Container -->
        <table
          width="100%"
          cellpadding="0"
          cellspacing="0"
          border="0"
          style="
            max-width: 600px;
            background-color: #ffffff;
            border-radius: 14px;
            overflow: hidden;
            box-shadow: 0 4px 20px rgba(0, 0, 0, 0.06);
          "
        >
          <!-- Header -->
          <tr>
            <td
              style="
                background-color: #111827;
                padding: 28px 35px;
                text-align: center;
              "
            >
              <div
                style="
                  display: inline-block;
                  background-color: #ffffff;
                  width: 46px;
                  height: 46px;
                  line-height: 46px;
                  border-radius: 12px;
                  font-size: 22px;
                  font-weight: bold;
                  color: #111827;
                "
              >
                U
              </div>
              <h1
                style="
                  margin: 14px 0 0;
                  color: #ffffff;
                  font-size: 22px;
                  font-weight: 600;
                "
              >
                University Management System
              </h1>
            </td>
          </tr>
          <!-- Content -->
          <tr>
            <td style="padding: 40px 35px 30px;">
              <h2
                style="
                  margin: 0 0 14px;
                  font-size: 24px;
                  color: #111827;
                "
              >
                <%= title %> Complete!
              </h2>
              <p
                style="
                  margin: 0 0 20px;
                  font-size: 15px;
                  line-height: 1.7;
                  color: #4b5563;
                "
              >
                Hello <strong><%= name %></strong>,
              </p>
              <p
                style="
                  margin: 0 0 25px;
                  font-size: 15px;
                  line-height: 1.7;
                  color: #4b5563;
                "
              >
                <%= message %>
              </p>
            </td>
          </tr>
          <!-- Footer -->
          <tr>
            <td
              style="
                padding: 22px 35px;
                background-color: #f9fafb;
                border-top: 1px solid #e5e7eb;
                text-align: center;
              "
            >
              <p
                style="
                  margin: 0;
                  font-size: 12px;
                  color: #9ca3af;
                "
              >
                © <%= year %> University Management System
              </p>
              <p
                style="
                  margin: 7px 0 0;
                  font-size: 11px;
                  color: #9ca3af;
                "
              >
                This is an automated email. Please do not reply.
              </p>
            </td>
          </tr>
        </table>
      </td>
    </tr>
  </table>
</body>
</html>
