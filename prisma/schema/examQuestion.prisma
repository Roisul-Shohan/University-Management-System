model ExamQuestion {
  id             String           @id @default(uuid())
  examId         String
  questionText   String
  marks          Int
  order          Int
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  exam           Exam             @relation(fields: [examId], references: [id], onDelete: Cascade)
  options        QuestionOption[]
  studentAnswers StudentAnswer[]

  @@unique([examId, order])
  @@index([examId])
  @@map("exam_questions")
}
