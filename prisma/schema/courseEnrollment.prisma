model CourseEnrollment {
  id String @id @default(uuid())

  courseOfferingId  String
  studentSemesterId String

  status EnrollmentStatus @default(ENROLLED)

  enrolledAt DateTime  @default(now())
  droppedAt  DateTime?

  courseOffering CourseOffering @relation(fields: [courseOfferingId], references: [id])

  studentSemester StudentSemester @relation(fields: [studentSemesterId], references: [id], onDelete: Cascade)
  result          Result?

  attendanceRecords AttendanceRecord[]
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  @@unique([studentSemesterId, courseOfferingId])
  @@index([studentSemesterId])
  @@index([courseOfferingId])
  @@index([status])
  @@map("course_enrollments")
}
