model SemesterFee {
  id        String   @id @default(uuid())
  programId String
  amount    Decimal  @db.Decimal(10, 2)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  program   Program  @relation(fields: [programId], references: [id])

  @@index([programId])
  @@index([isActive])
  @@map("semester_fees")
}
