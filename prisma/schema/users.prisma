model User {
  id       String     @id @default(uuid())
  email    String     @unique
  password String
  name     String
  address  String?
  role     Role
  status   UserStatus @default(ACTIVE)
  emailVerified Boolean   @default(false)


  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  student Student?
  teacher Teacher?

  @@index([role])
  @@index([status])
  @@index([emailVerified])
  @@map("users")
}
