model StudentAnswer {
  id            String          @id @default(uuid())
  examAttemptId String
  questionId    String
  optionId      String?
  answeredAt    DateTime        @default(now())
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  examAttempt   ExamAttempt     @relation(fields: [examAttemptId], references: [id], onDelete: Cascade)
  option        QuestionOption? @relation(fields: [optionId], references: [id])
  question      ExamQuestion    @relation(fields: [questionId], references: [id])

  @@unique([examAttemptId, questionId])
  @@index([questionId])
  @@index([optionId])
  @@map("student_answers")
}
