model AcademicPeriod {
  id   String             @id @default(uuid())
  type AcademicPeriodType

  startDate DateTime
  endDate   DateTime

  isActive Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([type])
  @@index([startDate, endDate])
  @@map("academic_periods")
}
