model AttendanceRecord {
  id String @id @default(uuid())

  attendanceSessionId String
  courseEnrollmentId  String

  status   AttendanceStatus
  markedAt DateTime         @default(now())

  attendanceSession AttendanceSession @relation(fields: [attendanceSessionId], references: [id], onDelete: Cascade)

  courseEnrollment CourseEnrollment @relation(fields: [courseEnrollmentId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([attendanceSessionId, courseEnrollmentId])
  @@index([attendanceSessionId])
  @@index([courseEnrollmentId])
  @@index([status])
  @@map("attendance_records")
}
